generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-delivery"
}

datasource db {
  provider = "postgresql"
  url      = env("MYDELIVERY_DB")
}

model orders {
  id          String  @id @db.VarChar(36)
  product     String  @db.VarChar(50)
  price       Decimal @db.Decimal(10, 2)
  photoUrl    String? @db.VarChar(255)
  quantity    Int
  total       Decimal @db.Decimal(10, 2)
  moment      String  @db.VarChar(150)
  client      String  @db.VarChar(255)
  state       String  @db.VarChar(50)
  address     String  @db.VarChar(255)
  description String
  payment     String? @db.VarChar(10)
}

model products {
  category    String  @db.VarChar(50)
  description String
  id          String  @id @db.VarChar(36)
  name        String  @db.VarChar(50)
  photoUrl    String? @db.VarChar(255)
  price       Decimal @db.Decimal(10, 2)
  stock       Int?
}

model reset_password {
  id            String   @id @db.VarChar(36)
  user_id       String?  @db.VarChar(36)
  token         String   @db.VarChar(255)
  expires_at    DateTime @db.Timestamptz(6)
  used          Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  restaurant_id String?  @db.VarChar(36)
  users         users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reset_password_user_id_foreign")
}

model restaurants {
  address  String  @db.VarChar(150)
  phone    String  @db.VarChar(15)
  category String  @db.VarChar(30)
  id       String  @id @db.VarChar(36)
  logourl  String? @db.VarChar(255)
  name     String  @db.VarChar(30)
  password String  @db.VarChar(255)
  email    String  @db.VarChar(150)
}

model users {
  id             String           @id @db.VarChar(36)
  username       String           @db.VarChar(50)
  email          String           @db.VarChar(150)
  phone          String           @db.VarChar(15)
  password       String           @db.VarChar(255)
  street         String?          @db.VarChar(150)
  cep            String?          @db.VarChar(10)
  number         String?          @db.VarChar(4)
  neighbourhood  String?          @db.VarChar(30)
  city           String?          @db.VarChar(30)
  state          String?          @db.VarChar(30)
  complement     String?          @db.VarChar(150)
  reset_password reset_password[]
}
