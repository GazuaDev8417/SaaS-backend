{
  "name": "saas-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:pull:dashboard": "prisma db pull --schema=./prisma/schema.prisma",
    "prisma:push:dashboard": "prisma db push --schema=./prisma/schema.prisma",
    "prisma:generate:dashboard": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:pull:delivery": "prisma db pull --schema=./prisma_delivery/deliverySchema.prisma",
    "prisma:push:delivery": "prisma db push --schema=./prisma_delivery/deliverySchema.prisma",
    "prisma:generate:delivery": "prisma generate --schema=./prisma_delivery/deliverySchema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
