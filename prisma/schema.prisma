generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DASHBOARD_DB")
}

model category {
  id    Int    @id(map: "Category_pkey") @default(autoincrement())
  name  String @db.VarChar(20)
  value Int
}

model customer {
  id        Int       @id(map: "Customer_pkey") @default(autoincrement())
  name      String    @db.VarChar(50)
  email     String    @unique(map: "Customer_email_key") @db.VarChar(255)
  phone     String    @db.VarChar(20)
  status    String    @db.VarChar(15)
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  order     order[]
}

model order {
  id           Int      @id(map: "Order_pkey") @default(autoincrement())
  product      String   @db.VarChar(30)
  total        Float
  status       String   @db.VarChar(20)
  customerId   Int
  customerName String   @db.VarChar(50)
  createdAt    DateTime @default(now())
  customer     customer @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "Order_customerId_fkey")
}

model product {
  id          Int       @id(map: "Product_pkey") @default(autoincrement())
  name        String    @db.VarChar(50)
  description String
  category    String    @db.VarChar(30)
  price       Float
  stock       Int
  status      String    @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
}

model revenue {
  id      Int    @id(map: "Revenue_pkey") @default(autoincrement())
  month   String @db.VarChar(20)
  revenue Int
  orders  Int
}

model statistics {
  id    Int    @id(map: "Statistics_pkey") @default(autoincrement())
  title String
  value Int
}

model user {
  id                          Int      @id(map: "User_pkey") @default(autoincrement())
  name                        String   @db.VarChar(50)
  email                       String   @unique(map: "User_email_key") @db.VarChar(255)
  password                    String   @db.VarChar(255)
  role                        String   @default("Admin") @db.VarChar(20)
  emailNotifs                 Boolean  @default(true)
  pushNotifs                  Boolean  @default(false)
  marketingEmails             Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime
  default_password_identifier String?  @unique(map: "User_default_password_identifier_key") @db.VarChar(255)
}
