generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DASHBOARD_DB")
}

model User {
  id                          Int      @id @default(autoincrement())
  name                        String   @db.VarChar(50)
  email                       String   @unique @db.VarChar(255)
  password                    String   @db.VarChar(255)
  role                        String   @default("Admin") @db.VarChar(20)
  emailNotifs                 Boolean  @default(true)
  pushNotifs                  Boolean  @default(false)
  marketingEmails             Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  default_password_identifier String?  @unique @db.VarChar(255)
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(50)
  description String
  category    String    @db.VarChar(30)
  price       Float
  stock       Int
  status      String    @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(50)
  email     String    @unique @db.VarChar(255)
  phone     String    @db.VarChar(20)
  status    String    @db.VarChar(15)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  orders    Order[]
}

model Order {
  id           Int      @id @default(autoincrement())
  product      String   @db.VarChar(30)
  total        Float
  status       String   @db.VarChar(20)
  customerId   Int
  customerName String   @db.VarChar(50)
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Revenue {
  id      Int    @id @default(autoincrement())
  month   String @db.VarChar(20)
  revenue Int
  orders  Int
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(20)
  value Int
}

model Statistics {
  id    Int    @id @default(autoincrement())
  title String
  value Int
}
